# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com dashboard -> API Keys)
RESEND_API_KEY=

# Where new-order notification emails are sent (your inbox, for now —
# see the Resend sandbox-domain limitation noted in PLANNING.md)
ADMIN_NOTIFICATION_EMAIL=
